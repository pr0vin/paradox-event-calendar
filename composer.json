{
  "name": "paradox/event-calendar",
  "description": "A customizable Laravel event calendar package.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "calendar",
    "events",
    "blade",
    "nepali-calendar",
    "bikram-sambat"
  ],
  "authors": [
    {
      "name": "Pravin Chaudhary",
      "email": "pravinchaudhary688@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/view": "^11.0|^12.0",
    "nesbot/carbon": "^3.13",
    "paradox/nepali-date": "*"
  },
  "autoload": {
    "psr-4": {
      "Paradox\\EventCalendar\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Paradox\\EventCalendar\\EventCalendarServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
