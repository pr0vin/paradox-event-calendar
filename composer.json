{
  "name": "parad0x/event-calendar",
  "description": "A Laravel event calendar component with Nepali date support.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "event-calendar",
    "calendar",
    "nepali-date",
    "nepali-calendar",
    "bs-date"
  ],
  "authors": [
    {
      "name": "Prabin Chaudhary"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/view": "^11.0|^12.0",
    "nesbot/carbon": "^3.13",
    "paradox/nepali-date": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Paradox\\EventCalendar\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Paradox\\EventCalendar\\EventCalendarServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
