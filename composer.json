{
  "name": "paradox/event-calendar",
  "repositories": [
    {
      "type": "path",
      "url": "../paradox-nepali-date",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/view": "^11.0|^12.0",
    "nesbot/carbon": "^3.13",
    "paradox/nepali-date": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Paradox\\EventCalendar\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Paradox\\EventCalendar\\EventCalendarServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
